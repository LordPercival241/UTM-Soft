# Supabase project configuration (Vercel → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Configuración del Asistente YoungBot (Sólo servidor: nunca exponer al cliente)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# (Opcional) Modelo específico. Si se omite, YoungBot auto-detectará el mejor modelo disponible (gemini-2.0-flash / gemini-1.5-flash).
GEMINI_MODEL=

# (Opcional) Clave service_role de Supabase para el cron keep-alive.
# Si no se define, el cron usa la anon key (suficiente para el ping).
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) Secreto para proteger el endpoint /api/cron/keep-alive.
# Vercel Cron lo inyecta automáticamente como header Authorization.
# Genere uno con: openssl rand -base64 32
CRON_SECRET= 
